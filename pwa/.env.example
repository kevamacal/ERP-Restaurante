# Variables públicas del frontend. Vite solo expone las que empiezan por VITE_
# y las incrusta en el bundle: aquí NUNCA va una clave con privilegios.
#
# La URL y la clave publishable de Supabase están diseñadas para ser públicas:
# la seguridad real la pone RLS en la base de datos.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_...
