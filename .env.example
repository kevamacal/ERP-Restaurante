# Copia este fichero a .env (no versionado) en la máquina del TPV.
# sync_agent.py lo carga automáticamente desde su mismo directorio.
#
# Usa una clave publishable/anon si el agente escribe con RLS habilitado, o una
# service_role SOLO si las políticas lo exigen. Una service_role salta RLS:
# trátala como una contraseña maestra y no la compartas.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-clave
